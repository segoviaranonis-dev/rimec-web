# Copiar como .env.local y completar — NUNCA subir .env.local al repo

# Supabase — supabase.com → proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR_CON_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY

# Auth — Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REEMPLAZAR_CON_SECRET_GENERADO
